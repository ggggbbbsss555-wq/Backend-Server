# ===== Bridge Server =====
PORT=8080
NODE_ENV=production
LOG_LEVEL=info

# ===== CORS — allowed origins for the Web App + admin dashboard =====
ALLOWED_ORIGINS=https://adminquantvexa.web.app,https://quantvexa.web.app,https://ggggbbbsss555-wq.github.io,http://localhost:3000,http://localhost:5173

# ===== Shared secret between this bridge and the residential server =====
# Must match the residential server's INTERNAL_SECRET
INTERNAL_SECRET=change-me-to-a-long-random-string

# ===== Residential Server URL (the home computer — source of ALL truth) =====
# This is where the Telegram bot, signals generator, candle server, and MongoDB live.
# When NOT set, the bridge returns 503 on all data endpoints.
# Example: https://your-home-server.example.com
RESIDENTIAL_SERVER_URL=

# ===== MongoDB (optional cache — speeds up reads) =====
# The residential server holds the real database. This is just a cache.
# Leave empty to skip caching.
MONGODB_URL=
MONGODB_DB=quantvexa

# ===== Admin credentials (for the admin dashboard login) =====
# The bridge checks these itself (no round-trip to the residential server)
ADMIN_EMAIL=admin@dashboard.io
ADMIN_PASSWORD=Admin@2024

# ===== Plan prices (for /api/plans when residential is down) =====
PLAN_BASIC_PRICE=50
PLAN_PRO_PRICE=75
PLAN_ELITE_PRICE=100
