# ===== Server =====
PORT=8080
NODE_ENV=production
LOG_LEVEL=info

# ===== CORS — allowed origins for the Telegram Web App + admin dashboard =====
# Comma-separated. The 4 quantvexa pages are hosted on GitHub Pages.
ALLOWED_ORIGINS=https://ggggbbbsss555-wq.github.io,http://localhost:3000,http://localhost:5173

# ===== Telegram — for validating initData sent by the Web App =====
# Get this from @BotFather → /newbot → token.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# ===== Internal webhook auth — shared secret between Node.js and Python =====
# Python signs every webhook call (X-Internal-Secret header) with this value.
INTERNAL_SECRET=change-me-to-a-long-random-string

# ===== MongoDB — the database (residential server) =====
# If set, all data persists to MongoDB (survives restarts).
# If not set, falls back to in-memory only (dev mode, data lost on restart).
# Local MongoDB:    mongodb://localhost:27017
# Docker MongoDB:   mongodb://mongo:27017
# Remote MongoDB:   mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=quantvexa

# ===== Admin credentials (for the admin dashboard login) =====
ADMIN_EMAIL=admin@dashboard.io
ADMIN_PASSWORD=Admin@2024

# ===== Signals generator config =====
# How often (seconds) the signals bot generates a new signal
SIGNAL_INTERVAL_SEC=30

# ===== Plan catalog (mirrors quantvexa/plans page) =====
# Prices are locked to 50/75/100 — see services/plans.js
PLAN_BASIC_PRICE=50
PLAN_PRO_PRICE=75
PLAN_ELITE_PRICE=100
