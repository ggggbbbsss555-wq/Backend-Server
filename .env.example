# ===== Server =====
PORT=8080
NODE_ENV=production
LOG_LEVEL=info

# ===== CORS — allowed origins for the Telegram Web App + admin dashboard =====
# Comma-separated. The 4 quantvexa pages are hosted on GitHub Pages.
ALLOWED_ORIGINS=https://ggggbbbsss555-wq.github.io,http://localhost:3000,http://localhost:5173

# ===== Telegram — for validating initData sent by the Web App =====
# Get this from @BotFather → /newbot → token.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# ===== Internal webhook auth — shared secret between Node.js and Python =====
# Python signs every webhook call (X-Internal-Secret header) with this value.
INTERNAL_SECRET=change-me-to-a-long-random-string

# ===== Python codebase endpoints (the 3 parts running in one codebase) =====
# Candle server: serves OHLCV data for the chart page
PYTHON_CANDLE_URL=http://localhost:9001
# Telegram bot: receives support-chat messages + sends notifications
PYTHON_TELEGRAM_URL=http://localhost:9002
# Signals bots: generate trading signals + bot status
PYTHON_SIGNALS_URL=http://localhost:9003

# ===== Firebase (admin dashboard integration — filled in later) =====
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ===== Plan catalog (mirrors quantvexa/plans page) =====
# Prices are locked to 50/75/100 — see services/plans.js
PLAN_BASIC_PRICE=50
PLAN_PRO_PRICE=75
PLAN_ELITE_PRICE=100
